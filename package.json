{
  "name": "dsh-session-settings",
  "version": "0.1.1",
  "description": "Per-session settings infrastructure for DSH: a native right-sidebar settings page plus a host-side store and API that other plugins register their options into.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/**/*.spec.mjs\""
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2"
  }
}
